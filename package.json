{
  "name": "heracross",
  "version": "0.1.0",
  "private": true,
  "description": "React Native bridge for the Scyther (iOS) and Scizor (Android) debugging toolkits",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "heracross-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./jest": "./jest/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "jest",
    "android",
    "ios",
    "patches",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!ios/.build",
    "!ios/.swiftpm",
    "!ios/Package.resolved",
    "!ios/Tests",
    "!android/src/test"
  ],
  "scripts": {
    "example": "yarn workspace heracross-example",
    "clean": "del-cli android/build ios/.build ios/.swiftpm example/android/build example/android/app/build example/android/app/.cxx example/ios/build example/ios/HeracrossExample.xcodeproj/project.xcworkspace/xcshareddata/swiftpm lib coverage .turbo",
    "prepare": "bob build",
    "prepack": "bob build",
    "typecheck": "tsc",
    "test": "jest",
    "test:ios": "node scripts/test-ios.js",
    "test:android": "cd example/android && ./gradlew :heracross:testDebugUnitTest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "debugging",
    "scyther",
    "scizor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bstillitano/heracross.git"
  },
  "author": "Brandon Stillitano <b.stillitano95@gmail.com> (https://github.com/bstillitano)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bstillitano/heracross/issues"
  },
  "homepage": "https://github.com/bstillitano/heracross#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "0.87.x"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "HeracrossSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.heracross"
    },
    "ios": {
      "modulesProvider": {
        "Heracross": "Heracross"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "heracross-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "resolutions": {
    "react-native@npm:0.87.1": "patch:react-native@npm%3A0.87.1#~/.yarn/patches/react-native-npm-0.87.1-f618c82e97.patch"
  }
}
