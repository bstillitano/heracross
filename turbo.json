{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build:android": {
      "env": [
        "ANDROID_HOME",
        "JAVA_HOME",
        "ORG_GRADLE_PROJECT_newArchEnabled"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/.yarn/patches/**",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "package.json",
        "src/native/**",
        "android/**",
        "!android/build/**",
        "!android/.gradle/**",
        "!android/app/build/**",
        "!android/app/.cxx/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "DEVELOPER_DIR"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/.yarn/patches/**",
        "$TURBO_ROOT$/ios/**",
        "!$TURBO_ROOT$/ios/.build/**",
        "!$TURBO_ROOT$/ios/.swiftpm/**",
        "package.json",
        "react-native.config.js",
        "scripts/**",
        "src/native/**",
        "ios/**",
        "!ios/build/**"
      ],
      "outputs": []
    }
  }
}
